# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
#CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

CONFIG_FATFS_LFN_HEAP=y


CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7000 

# NimBLE specific settings (adjust as needed)
#CONFIG_NIMBLE_STACK_USE_MEM_POOLS=y
#CONFIG_NIMBLE_MEM_POOL_UNIT_COUNT=10 # Adjust based on expected connections/operations
#CONFIG_NIMBLE_MAX_CONNECTIONS=3      # Max concurrent BLE connections
#CONFIG_NIMBLE_MAX_BONDS=3            # Max bonded devices
#CONFIG_NIMBLE_MAX_CCCDS=8            # Max Client Characteristic Configuration Descriptors
#CONFIG_NIMBLE_SVC_GAP_DEVICE_NAME="Personal-Cloud" # Set your device name
#CONFIG_NIMBLE_ATT_PREFERRED_MTU=256  # Increase MTU for potentially larger data transfers
# Enable GAP Peripheral Role (Needed for advertising/being connectable)
#CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# Enable GATT Server (Needed for your BleProvisioningServer)
#CONFIG_BT_NIMBLE_ROLE_PERIPHERAL_GATT_SERVER=y
